# ==========================================================================
# BlogVerse AI Author Workflow - environment configuration
# This folder (agents/) owns its own .env, same convention as
# server/.env and client/blog-versum/.env.
#   cp agents/.env.example agents/.env
# `.env` is loaded via python-dotenv from this file's own directory,
# regardless of the working directory you run `python -m agents.main` from.
# Never commit the real .env - see .gitignore.
# ==========================================================================

# --- LLM (required) -------------------------------------------------------
# Groq API key for ChatGroq (model: llama-3.3-70b-versatile).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Research / web search (optional) -------------------------------------
# Tavily key used by the research loop. If left blank, the workflow still
# runs but skips web search (research_router simply proceeds with no evidence).
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# --- Long-term memory: PostgreSQL (required to run main.py) ----------------
# Postgres connection string for langgraph PostgresStore (author memory).
# Matches agents/docker-compose.yml (Postgres exposed on host port 5442).
# Override host/port/user/password/db if you point at a different instance.
BLOGVERSE_DB_URI=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable

# --- LangSmith tracing (optional) -----------------------------------------
# Enable to see the full execution path for each node in LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Project name traces are grouped under (main.py sets a default if unset).
LANGSMITH_PROJECT=blog-versum
