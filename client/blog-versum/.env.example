# ==========================================================================
# BlogVerse frontend (client/blog-versum/) environment configuration
#   cp .env.example .env   then fill in values (or set them in Vercel).
# These are BUILD-TIME and PUBLIC — they get inlined into the shipped JS bundle.
# NEVER put a secret here.
# ==========================================================================

# Base URL for API calls. Local dev uses the Vite dev server proxy / localhost, so
# this can be left unset (falls back to "/api"). In the split prod deployment set it
# to the EC2 API origin, e.g.:
#   VITE_API_URL=https://blogversum-api.duckdns.org/api
VITE_API_URL=

# Absolute origin of the Socket.IO server (the EC2 backend). Only used in production
# builds; dev uses http://localhost:5001 automatically. e.g.:
#   VITE_SOCKET_URL=https://blogversum-api.duckdns.org
VITE_SOCKET_URL=
