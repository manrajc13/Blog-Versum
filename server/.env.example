# ==========================================================================
# BlogVerse backend (server/) environment configuration
#   cp server/.env.example server/.env   then fill in the values.
# Never commit the real .env.
# ==========================================================================

# --- Database -------------------------------------------------------------
MONGODB_URI=

# --- Server ---------------------------------------------------------------
PORT=5001
NODE_ENV=development

# --- Auth (JWT for user sessions) -----------------------------------------
JWT_SECRET=

# --- Cloudinary (cover image uploads) -------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend -------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# --- Redis (feed caching) --------------------------------------------------
# In Docker Compose, this resolves to the `redis` service on the shared network.
# For local dev without Docker, point at a local Redis instance instead
# (e.g. redis://localhost:6379).
REDIS_URL=redis://redis:6379

# --- Email (OTP / verification) -------------------------------------------
EMAIL=
EMAIL_PASSWORD=

# --- Internal publishing API ----------------------------------------------
# Shared secret for the machine-to-machine internal API
# (POST /api/internal/posts), used by the Python LangGraph publisher.
# The caller must send this exact value in the `x-api-key` header.
# NOT a JWT — there is no user session behind these calls.
# Generate a strong random value, e.g.  openssl rand -hex 32
INTERNAL_API_KEY=
